# Exactly six digits. Never expose this value through VITE_* or commit a real key.
EDITOR_ACCESS_KEY=123456

# Cloudflare R2 S3 credentials, scoped to one bucket with Object Read & Write.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=minelog-content
# Optional for EU/FedRAMP jurisdictions; otherwise omit.
# R2_ENDPOINT=https://your-account-id.eu.r2.cloudflarestorage.com
