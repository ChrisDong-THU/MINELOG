{
    "name": "minelog-knowledge-repository",
    "version": "0.1.0",
    "license": "GPL-3.0-only",
    "private": true,
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "dev": "vinext dev",
        "build": "vinext build",
        "build:vercel": "vite build",
        "start": "vinext start",
        "test:unit": "node --experimental-strip-types --test tests/editor-auth.test.mjs tests/r2-svg-assets.test.mjs tests/shared-storage-rules.test.mjs",
        "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "check": "npm run lint && npm run typecheck && npm test",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel"
    },
    "dependencies": {
        "aws4fetch": "^1.0.20",
        "decode-named-character-reference": "1.3.0",
        "katex": "0.16.47",
        "next": "16.2.6",
        "nitro": "^3.0.260610-beta",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "react-server-dom-webpack": "19.2.6",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    },
    "type": "module"
}
